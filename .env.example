# Revenue Recovery Agent — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit real secrets.

# Database — from Neon (do NOT share or commit real credentials)
# Synchronous SQLAlchemy 2.x + psycopg driver.
# Neon requires TLS: keep sslmode=require in the URL.
DATABASE_URL=postgresql+psycopg://username:password@ep-name.region.postgres.neon.tech/database_name?sslmode=require

# Application
APP_ENV=development
DEBUG=True